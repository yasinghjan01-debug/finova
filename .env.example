# FINOVA Environment Configuration Template
# Copy to .env and fill in your credentials

# Database Configuration (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=postgresql://finova_user:finova_secure_password@postgres:5432/finova_db
# DATABASE_URL=sqlite:///./finova.db

# Security & Session Authentication
SECRET_KEY=generate_with_openssl_rand_hex_32_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Razorpay Sandbox / Live API Credentials
# Obtain from: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret (HMAC-SHA256 verification)
# Configured in: https://dashboard.razorpay.com/#/app/webhooks
RAZORPAY_WEBHOOK_SECRET=

# Service Ports & Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
